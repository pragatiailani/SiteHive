# PostgreSQL (docker-compose.yml)
POSTGRES_USER=sitehive
POSTGRES_PASSWORD=sitehive
POSTGRES_DB=sitehive
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sitehive:sitehive@localhost:5432/sitehive

# FalkorDB (docker-compose.yml; 6379 is the DB, 3000 is the browser UI)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000
